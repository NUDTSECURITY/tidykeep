{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.tidykeep/runtime/hook.mjs",
              "claude-pretooluse"
            ],
            "timeout": 20,
            "statusMessage": "tidykeep: 检查文件命名"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.tidykeep/runtime/hook.mjs",
              "claude-pretooluse"
            ],
            "timeout": 20,
            "statusMessage": "tidykeep: 检查命令"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.tidykeep/runtime/hook.mjs",
              "claude-stop"
            ],
            "timeout": 30,
            "statusMessage": "tidykeep: 收尾检查"
          }
        ]
      }
    ]
  }
}
